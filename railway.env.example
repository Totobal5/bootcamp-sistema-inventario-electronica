# ===================================================================
# Variables de Entorno para Railway
# ===================================================================
# IMPORTANTE: Configurar estas variables en Railway Dashboard
# Proyecto → Settings → Variables
# ===================================================================

# === Profile de Spring Boot ===
SPRING_PROFILES_ACTIVE=prod

# === Puerto (Railway usa PORT dinámico, no editar) ===
# Railway configura automáticamente PORT, no es necesario configurarlo

# === Base de Datos PostgreSQL ===
# Railway genera automáticamente estas variables cuando agregas PostgreSQL
# SPRING_DATASOURCE_URL se configura automáticamente desde DATABASE_URL

# Si prefieres configurarlas manualmente:
# SPRING_DATASOURCE_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/${PGDATABASE}
# SPRING_DATASOURCE_USERNAME=${PGUSER}
# SPRING_DATASOURCE_PASSWORD=${PGPASSWORD}

# === JWT Configuration (OBLIGATORIO) ===
# Generar con: openssl rand -base64 32
JWT_SECRET=REEMPLAZAR_CON_SECRETO_SEGURO_BASE64_256_BITS
JWT_EXPIRATION=86400000

# === JPA Configuration ===
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# === File Upload ===
FILE_UPLOAD_DIR=/app/uploads
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB

# === Logging ===
LOGGING_LEVEL_COM_BOOTCAMP_INVENTARIO=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN
LOGGING_LEVEL_ORG_HIBERNATE=WARN

# ===================================================================
# PASOS PARA CONFIGURAR EN RAILWAY:
# ===================================================================
# 1. Ir a tu proyecto en Railway Dashboard
# 2. Seleccionar el servicio de la aplicación
# 3. Click en "Variables"
# 4. Agregar una por una las variables de arriba
# 5. Para PostgreSQL:
#    - Click en "+ New" → Database → PostgreSQL
#    - Railway genera automáticamente las variables de BD
#    - En tu servicio, hacer referencia a estas variables
# 6. GENERAR JWT_SECRET:
#    - Ejecutar localmente: openssl rand -base64 32
#    - Copiar el resultado en JWT_SECRET
# ===================================================================
