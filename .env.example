# Configuración de PostgreSQL
POSTGRES_DB=inventario_electronica
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Configuración de la Aplicación
APP_PORT=8081

# JWT (IMPORTANTE: Generar una clave segura de 256 bits en producción)
# Puedes generar una con: openssl rand -base64 32
JWT_SECRET=your-secret-key-min-256-bits-change-this-in-production
JWT_EXPIRATION=86400000

# Upload de archivos
FILE_UPLOAD_DIR=uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# Logging
LOG_LEVEL=INFO
SHOW_SQL=false
FORMAT_SQL=false

# Notas:
# 1. Copiar este archivo a .env: cp .env.example .env
# 2. Modificar los valores según tu entorno
# 3. NUNCA commitear el archivo .env al repositorio (ya está en .gitignore)
# 4. En producción, usar variables de entorno del sistema o secrets manager

